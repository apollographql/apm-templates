# ── Classic API (Dashboards Classic / live.dynatrace.com) ─────────────────────
# Used by: ./upload-dashboard.sh ../dashboard-template.json
#
# DYNATRACE_URL=https://{your-environment-id}.live.dynatrace.com
# DYNATRACE_API_TOKEN=your_api_token_with_WriteConfig_scope

# ── Grail / Document API (apps.dynatrace.com) ────────────────────────────────
# Used by: ./upload-dashboard.sh ../dashboard-template-grail.json --grail
#
# How to get credentials:
#   1. In apps.dynatrace.com go to Settings → Account Management → OAuth Clients
#   2. Create a new OAuth client with scope: document:documents:write
#   3. Copy the client ID and secret below
#
# DYNATRACE_ENV_ID=gap82635
# DYNATRACE_OAUTH_CLIENT_ID=dt0s02.XXXXXXXXXXXXXXXX
# DYNATRACE_OAUTH_CLIENT_SECRET=dt0s02.XXXXXXXXXXXXXXXX.YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY
