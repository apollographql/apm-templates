          {
            "definition": {
              "legend_columns": [
                "avg",
                "min",
                "max",
                "value",
                "sum"
              ],
              "legend_layout": "auto",
              "requests": [
                {
                  "display_type": "line",
                  "formulas": [
                    {
                      "formula": "100 * errors / total",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "percent"
                        }
                      }
                    }
