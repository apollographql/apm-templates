{
  "dashboardMetadata": {
    "name": "Apollo MCP Server Dashboard Template",
    "owner": "apm-templates",
    "shared": true,
    "dynamicFilters": {
      "filters": [
        "SERVICE_TAG_KEY:service",
        "CUSTOM_DIMENSION:env"
      ],
      "genericTagFilters": []
    }
  },
  "tiles": [
    {
      "name": "Service overview",
      "tileType": "MARKDOWN",
      "configured": true,
      "bounds": {
        "top": 0,
        "left": 0,
        "width": 1824,
        "height": 550
      },
      "tileFilter": {},
      "markdown": "## $service #$env\n\nUse dashboard filters (service, env) to scope to your Apollo MCP Server. For a native service-centric view, assign a Dynatrace service entity to a SERVICE_VERSATILE tile or link to the service from here."
    },
    {
      "name": "MCP Tool Call Count (split by tool name)",
      "tileType": "DATA_EXPLORER",
      "configured": true,
      "bounds": {
        "top": 550,
        "left": 0,
        "width": 912,
        "height": 150
      },
      "tileFilter": {},
      "customName": "MCP Tool Call Count (split by tool name)",
      "queries": [
        {
          "id": "A",
          "metric": "custom:apollo.mcp.tool.count",
          "timeAggregation": "DEFAULT",
          "spaceAggregation": "SUM",
          "splitBy": [
            "apollo.mcp.tool_name"
          ],
          "filterBy": {
            "filterOperator": "AND",
            "nestedFilters": [],
            "criteria": [
              {
                "filterType": "DIMENSION",
                "dimensionKey": "apollo.mcp.success",
                "evaluator": "EQ",
                "value": "true"
              }
            ]
          },
          "limit": 100,
          "enabled": true
        },
        {
          "id": "B",
          "metric": "custom:apollo.mcp.tool.count",
          "timeAggregation": "DEFAULT",
          "spaceAggregation": "SUM",
          "splitBy": [
            "apollo.mcp.tool_name"
          ],
          "filterBy": {
            "filterOperator": "AND",
            "nestedFilters": [],
            "criteria": [
              {
                "filterType": "DIMENSION",
                "dimensionKey": "apollo.mcp.success",
                "evaluator": "EQ",
                "value": "false"
              }
            ]
          },
          "limit": 100,
          "enabled": true
        }
      ],
      "queriesSettings": {
        "resolution": ""
      },
      "visualConfig": {
        "type": "GRAPH_CHART",
        "global": {
          "hideLegend": false,
          "seriesType": "COLUMN"
        },
        "rules": [
          {
            "matcher": "A:",
            "valueFormat": "auto",
            "properties": {
              "color": "DEFAULT",
              "seriesType": "COLUMN"
            },
            "seriesOverrides": []
          }
        ],
        "axes": {
          "xAxis": {
            "displayName": "",
            "visible": true
          },
          "yAxes": [
            {
              "displayName": "",
              "visible": true,
              "min": "AUTO",
              "max": "AUTO",
              "position": "LEFT",
              "queryIds": [
                "A"
              ],
              "defaultAxis": true
            }
          ]
        },
        "graphChartSettings": {
          "connectNulls": true
        }
      },
      "metricExpressions": []
    },
