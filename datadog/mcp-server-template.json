                    {
                      "formula": "query1",
                      "style": {
                        "palette": "warm"
                      }
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "count:mcp.server.operation.duration{$service, $env, error.type:*} by {mcp.method.name,error.type}.as_count()"
                    }
